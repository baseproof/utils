RETRIEVER_BASE=http://host.docker.internal:8080




# Run identity — REQUIRED. Paths are in-container (matched to the
# -v mount below). Same RUN_ID on a rerun = resume from snapshot;
# change it for a fresh full-cost run.
RUN_ID=TR-local-bhm-001
RUN_INPUT_PATH=/run/input.json
RUN_OUTPUT_URI=/run/out
RUN_ARTIFACT_PREFIX=/run/artifacts


# Watch door — set web to watch/drive at localhost:6080/watch;
# off = zero watch processes
RUN_WATCH=web
RUN_VNC_CONTROL_PASSWORD=pick-a-control-secret
RUN_VNC_VIEW_PASSWORD=pick-a-view-secret

# Telemetry — trajectory.jsonl on; no callback URL = log-only
# stream (the run is unaffected)
RUN_TRAJECTORY=1
# RUN_CALLBACK_URL=
# RUN_CALLBACK_TOKEN=

# Models — code defaults are already the powerful tier
# (claude-opus-5 everywhere it matters, gemini-3.7-flash for
# extraction). The one override we agreed to set locally:
ENCUMBRANCE_REVIEW_MODEL=claude-fable-5