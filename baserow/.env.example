# Copy to .env — the script loads it automatically. Keep .env out of git.

# Your database token. Used for: check, backfill, verify.
# Create/manage at Baserow → Settings → Database tokens. It must cover the Timesheet table (read)
# and the 7 ledger tables (create/read/update) — easiest is a token scoped to all tables in the workspace.
BASEROW_TOKEN=

# Needed ONLY for `schema` (creates tables/fields/views) and `teardown`. Baserow does not let a
# database token create tables or fields — see the generated API docs: token endpoints are rows,
# list fields, upload, all-tables. Fill these in for that one run, then blank them out again.
BASEROW_EMAIL=
BASEROW_PASSWORD=

# Defaults are baserow.io and the Child Care database. Override only if self-hosting.
BASEROW_URL=https://api.baserow.io
BASEROW_DATABASE_ID=566910
BASEROW_TIMESHEET_TABLE_ID=1215333
