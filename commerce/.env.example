# Copy to .env next to baserow_schema.py (keep it out of git). Same conventions as ../baserow/.env.

# Database token (Baserow → Settings → Database tokens). Enough for `plan` and, later, the loader.
# Scope it to the Shopping database's tables (or all tables) so the new tables are covered.
BASEROW_TOKEN=

# Only for `apply` / `teardown` (creating tables and fields needs a login). Leave blank to be
# prompted instead; the password is never stored or printed by the script.
BASEROW_EMAIL=
BASEROW_PASSWORD=

BASEROW_URL=https://api.baserow.io
BASEROW_SHOPPING_DATABASE_ID=566971
